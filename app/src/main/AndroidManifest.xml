<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Approximate location only: enough for a city-level forecast -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The clock widget redraws at the start of each minute; Android asks you to allow this once (Clock settings has the button) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Fallback for the clock widget's time tap: most Clock apps only open their alarms for apps that hold this -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lets the clock widget find the phone's Clock app -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.coloros.alarmclock" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:supportsRtl="true"
        android:theme="@style/Theme.Awe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Awe.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Awe.WidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TinyWidget"
            android:exported="false"
            android:label="@string/widget_tiny_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tiny_info" />
        </receiver>

        <receiver
            android:name=".widget.SmallWidget"
            android:exported="false"
            android:label="@string/widget_daily_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_info" />
        </receiver>

        <receiver
            android:name=".widget.HourlyWidget"
            android:exported="false"
            android:label="@string/widget_hourly_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hourly_info" />
        </receiver>

        <receiver
            android:name=".widget.ForecastWidget"
            android:exported="false"
            android:label="@string/widget_forecast_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_forecast_info" />
        </receiver>

        <activity
            android:name=".widget.ClockSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Awe.WidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ClockWidget"
            android:exported="false"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <!-- The clock's minute alarm, plus the time, time zone and language changing, app updates, and the minute permission being allowed -->
        <receiver
            android:name=".widget.ClockTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.RefreshReceiver"
            android:exported="false" />

    </application>
</manifest>
