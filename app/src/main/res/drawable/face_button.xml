<?xml version="1.0" encoding="utf-8"?>
<!-- A clock style choice: outlined in the accent color when picked -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/line_strong" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
