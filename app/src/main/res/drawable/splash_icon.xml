<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading-screen icon: the app tile with a soft blue glow. Android stretches every layer to the full
  icon area and shows only the middle two-thirds, so sizes are set with percentage insets.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset android:inset="16.7%">
            <shape android:shape="oval">
                <gradient android:type="radial" android:gradientRadius="50%p"
                    android:startColor="#5978AAFF" android:centerColor="#2678AAFF" android:endColor="#0078AAFF" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:drawable="@drawable/app_tile" android:inset="28.5%" />
    </item>
</layer-list>
