<?xml version="1.0" encoding="utf-8"?>
<!-- A settings switch's track: accent when on, gray when off, with a thin ProStellis pale green outline so it stands out on dark sheets -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/switch_disabled" />
            <stroke android:width="1dp" android:color="@color/switch_outline" />
            <size android:width="44dp" android:height="24dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/accent" />
            <stroke android:width="1dp" android:color="@color/switch_outline" />
            <size android:width="44dp" android:height="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/switch_off" />
            <stroke android:width="1dp" android:color="@color/switch_outline" />
            <size android:width="44dp" android:height="24dp" />
        </shape>
    </item>
</selector>
