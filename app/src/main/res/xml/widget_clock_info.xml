<?xml version="1.0" encoding="utf-8"?>
<!-- Settings open when the clock is placed, and again by long-pressing it (reconfigure). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.prostellis.awe.widget.ClockSettingsActivity"
    android:description="@string/widget_clock_description"
    android:initialLayout="@layout/widget_clock"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/preview_clock"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
